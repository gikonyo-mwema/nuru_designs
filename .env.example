# Database (Supabase PostgreSQL)
DATABASE_URI=postgresql://user:password@host:5432/database_name
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
# Keep verification enabled. Set to false only for a provider using a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Payload CMS Admin
PAYLOAD_SECRET=your-secret-key-here-min-32-chars

# Cloudinary Image Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Vercel Deployment
VERCEL_URL=your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Optional contact email notifications (sender domain must be verified with Resend)
RESEND_API_KEY=re_your-api-key
CONTACT_RECIPIENT_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=website@example.com

# Public social links
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your-handle
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/your-company
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/254700000000

# Supabase (Optional - if using for additional services)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Environment
NODE_ENV=development
